{
    "name": "balancer/backendbase-core-legacy",
    "description": "Hexagonal (Ports and Adapters) Architecture and CQRS Ready Application Core!",
    "type": "project",
    "homepage": "https://github.com/reformo/backendbase-core",
    "license": "MIT",
    "keywords": [
        "skeleton",
        "middleware",
        "psr",
        "psr-7",
        "psr-11",
        "psr-15",
        "zf",
        "zendframework",
        "mezzio",
        "cqrs",
        "hexagonal",
        "tactician",
        "commandbus",
        "doctrine"
    ],
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.5.0"
        },
        "allow-plugins": {
            "malukenho/mcbumpface": true,
            "laminas/laminas-component-installer": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "cweagans/composer-patches": true
        }
    },
    "extra": {
        "zf": {
            "component-whitelist": [
                "mezzio/mezzio",
                "mezzio/mezzio-helpers",
                "mezzio/mezzio-router",
                "laminas/laminas-httphandlerrunner",
                "mezzio/mezzio-fastroute",
                "mezzio/mezzio-twigrenderer"
            ]
        },
        "patches": {
            "doctrine/dbal": [
                {
                    "description": "PHP 8.5 PostgreSQL PDO constants and string interpolation compatibility",
                    "url": "patches/doctrine-dbal-2.13.9-php85.patch",
                    "sha256": "3c7fd12066b0ee82eab90c70135c7ff9b84821ceec96ccd82efca1950b66b3ef",
                    "depth": 1
                }
            ]
        }
    },
    "support": {
        "issues": "https://github.com/reformo/hexagonal-cqrs-skeleton/issues",
        "source": "https://github.com/reformo/hexagonal-cqrs-skeleton",
        "rss": "https://github.com/reformo/hexagonal-cqrs-skeleton/releases.atom"
    },
    "require": {
        "php": "^8.5",
        "ext-apcu": "*",
        "ext-dom": "*",
        "ext-gd": "*",
        "ext-gettext": "*",
        "ext-json": "*",
        "ext-libxml": "*",
        "ext-pdo": "*",
        "ext-redis": "*",
        "ext-sodium": "*",
        "akrabat/ip-address-middleware": "^2.6.1",
        "cocur/slugify": "^v4.7.1",
        "cweagans/composer-patches": "^2.0.0",
        "doctrine/annotations": "^2.0.2",
        "doctrine/collections": "^1.8.0",
        "doctrine/dbal": "^2.13.9",
        "doctrine/orm": "^2.20.13",
        "gettext/gettext": "^v5.7.3",
        "guzzlehttp/guzzle": "^7.16.0",
        "intervention/image": "^3.11.10",
        "keiko/uuid-shortener": "^1.2.0",
        "laminas/laminas-component-installer": "^3.8.0",
        "laminas/laminas-config-aggregator": "^1.20.0",
        "laminas/laminas-diactoros": "^3.9.0",
        "laminas/laminas-inputfilter": "^2.35.0",
        "laminas/laminas-permissions-rbac": "^3.8.0",
        "laminas/laminas-servicemanager": "^3.24.0",
        "laminas/laminas-stdlib": "^3.21.0",
        "lcobucci/jwt": "^5.6.1",
        "league/flysystem": "^3.36.0",
        "league/flysystem-local": "^3.35.3",
        "league/tactician": "^2.0-rc1",
        "mezzio/mezzio": "^3.28.1",
        "mezzio/mezzio-csrf": "^1.11.0",
        "mezzio/mezzio-fastroute": "^3.14.0",
        "mezzio/mezzio-helpers": "^5.20.0",
        "mezzio/mezzio-problem-details": "^1.19.0",
        "mezzio/mezzio-session-ext": "^1.21.0",
        "mezzio/mezzio-twigrenderer": "^2.19.0",
        "mkorkmaz/redislabs-rejson": "^3.0",
        "moneyphp/money": "^v3.3.3",
        "monolog/monolog": "^2.11.1",
        "nesbot/carbon": "^2.73.0",
        "nikolaposa/rate-limit": "^2.2.0",
        "phpoffice/phpspreadsheet": "^5.10.0",
        "psr/container": "^1.1.2",
        "psr/http-message": "^1.1",
        "psr/http-server-handler": "^1.0.2",
        "psr/http-server-middleware": "^1.0.2",
        "psr/log": "^1.1.4",
        "ramsey/uuid": "^4.9.4",
        "ramsey/uuid-doctrine": "^1.8.2",
        "robinvdvleuten/ulid": "^5.0.0",
        "scienta/doctrine-json-functions": "^4.5.0",
        "selami/stdlib": "^2.6",
        "symfony/cache": "^v6.4.47",
        "symfony/polyfill-intl-icu": "^v1.43.0",
        "vlucas/phpdotenv": "^v3.6.10",
        "webmozart/assert": "^1.12.1"
    },
    "require-dev": {
        "behat/behat": "^v3.34.0",
        "doctrine/coding-standard": "^13.0.1",
        "filp/whoops": "^2.18.7",
        "laminas/laminas-development-mode": "^3.15.0",
        "malukenho/mcbumpface": "^1.2.0",
        "mezzio/mezzio-tooling": "^2.14.0",
        "phpunit/phpunit": "^12.5.40",
        "roave/security-advisories": "dev-master",
        "rskuipers/php-assumptions": "^0.9.1",
        "squizlabs/php_codesniffer": "^3.13.6",
        "swoole/ide-helper": "^4.8.13"
    },
    "autoload": {
        "psr-4": {
            "BackendBase\\Shared\\": "src/BackendBase/Shared/",
            "BackendBase\\Domain\\": "src/BackendBase/Domain/",
            "BackendBase\\Infrastructure\\": "src/BackendBase/Infrastructure/",
            "BackendBase\\PrivateApi\\": "src/BackendBase/Infrastructure/Ui/PrivateApi/",
            "BackendBase\\PublicWeb\\": "src/BackendBase/Infrastructure/Ui/PublicWeb/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "IntegrationTest\\": "test/IntegrationTest/",
            "UnitTest\\": "test/UnitTest/",
            "Fixtures\\": "test/Fixtures/"
        }
    },
    "scripts": {
        "post-create-project-cmd": [
            "@development-enable",
            "cp .env.dist .env",
            "cp config/autoload/doctrine.local.php.dist config/autoload/doctrine.local.php",
            "cp config/autoload/mezzio-swoole.local.php.dist config/autoload/mezzio-swoole.local.php"
        ],
        "post-install-cmd": [
            "composer dumpautoload -o"
        ],
        "development-disable": "laminas-development-mode disable",
        "development-enable": "laminas-development-mode enable",
        "development-status": "laminas-development-mode status",
        "expressive": "laminas --ansi",
        "check": [
            "@cs-check",
            "@check-assumptions",
            "@test"
        ],
        "cs-check": "vendor/bin/phpcs --standard=Doctrine",
        "cs-fix": "vendor/bin/phpcbf --standard=Doctrine",

        "test": "bash test/run-characterization-tests.sh",
        "test-unit": "@php vendor/bin/phpunit --testsuite 'BackendBase Unit Tests'",
        "test-coverage": "bash test/run-characterization-tests.sh --coverage-clover clover.xml"
    }
}
